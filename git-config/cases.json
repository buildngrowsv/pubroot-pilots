 {
  "id": "L01",
  "text": "[core]\n\trepositoryformatversion = 0\n\tfilemode = true\n\tbare = false\n\tlogallrefupdates = true\n[remote \"origin\"]\n\turl = git@github.com:o/r.git\n\tfetch = +refs/heads/*:refs/remotes/origin/*\n[branch \"main\"]\n\tremote = origin\n\tmerge = refs/heads/main\n",
  "group": "practical files"
 },
 {
  "id": "L02",
  "text": "[submodule \"vendor/lib\"]\n\tpath = vendor/lib\n\turl = https://github.com/o/lib.git\n\tbranch = main\n",
  "group": "practical files"
 },
 {
  "id": "L03",
  "text": "[alias]\n\tlg = log --graph --pretty=format:'%h -%d %s (%cr) <%an>'\n\tst = status -sb\n",
  "group": "practical files"
 },
 {
  "id": "L04",
  "text": "[alias]\n\tamend = \"!git commit --amend --no-edit\"\n\tlast = log -1 HEAD\n",
  "group": "practical files"
 },
 {
  "id": "L05",
  "text": "[url \"git@github.com:\"]\n\tinsteadOf = https://github.com/\n",
  "group": "practical files"
 },
 {
  "id": "L06",
  "text": "[user]\n\tname = \"Ada Lovelace\"\n\temail = ada@example.com\n[includeIf \"gitdir:~/work/\"]\n\tpath = ~/.gitconfig-work\n",
  "group": "practical files"
 },
 {
  "id": "L07",
  "text": "[filter \"lfs\"]\n\tclean = git-lfs clean -- %f\n\tsmudge = git-lfs smudge -- %f\n\tprocess = git-lfs filter-process\n\trequired = true\n",
  "group": "practical files"
 },
 {
  "id": "L08",
  "text": "[diff \"word\"]\n\ttextconv = docx2txt\n[merge]\n\tconflictstyle = zdiff3\n[pull]\n\trebase\n",
  "group": "practical files"
 }
]